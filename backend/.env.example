
# Conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/hermanos-jota

# Puerto del servidor
PORT=3000

# Clave secreta para firmar los JWT (mínimo 32 caracteres)
JWT_SECRET=reemplazar_por_una_clave_segura_de_al_menos_32_caracteres

# Origen(es) autorizado(s) para las solicitudes del frontend
# Se pueden indicar varios separados por comas.
CLIENT_URL=http://localhost:5173
